{
  "name": "keyword-scanner",
  "version": "1.0.0",
  "description": "本地文档关键词检索工具",
  "main": "electron/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs",
    "preview": "vite preview",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "desktop:build": "vite build && node scripts/prepare-desktop-build.mjs",
    "desktop:dev": "npm run desktop:build && electron .",
    "dist:win": "npm run desktop:build && electron-builder --win nsis"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.local.keywordscanner",
    "productName": "关键词检索器",
    "directories": { "output": "release" },
    "files": ["dist/desktop/**", "electron/**", "package.json"],
    "extraResources": [{ "from": "backend/dist-win/keyword-scanner-api", "to": "backend/keyword-scanner-api" }],
    "win": { "target": ["nsis"] },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
